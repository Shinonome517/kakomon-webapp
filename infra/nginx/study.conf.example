# Human installation template. Replace hostname/certificate paths before use.
# Under http{}: geo examines the ORIGINAL socket peer; do not enable real_ip here.
geo $cloudflare_peer {
    default 0;
    include /etc/nginx/cloudflare-ipv6.geo;
}
server {
    listen [::]:443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}
server {
    listen [::]:443 ssl;
    server_name study.example.com;
    ssl_certificate /etc/nginx/tls/origin.crt;
    ssl_certificate_key /etc/nginx/tls/origin.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    if ($cloudflare_peer = 0) { return 403; }
    if ($http_cf_connecting_ip = "") { return 403; }
    client_max_body_size 1m;
    location /media/ { return 404; }
    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_set_header Host study.example.com;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Verified-Client-IP $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Real-IP "";
        proxy_cache off;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
    }
}
